# Copy this file to .env for local development. Replace the example password.
POSTGRES_DB=zuno
POSTGRES_USER=zuno
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_URL=postgresql+psycopg://zuno:replace_with_a_local_password@localhost:5432/zuno
GOOGLE_API_KEY=replace_with_your_gemini_api_key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
